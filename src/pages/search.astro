---
import { getCollection } from 'astro:content';
import { Search } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).map((p) => ({ title:p.data.title, description:p.data.description, category:p.data.category, tags:p.data.tags, url:`/articles/${p.id}/` }));
---
<BaseLayout title="站内搜索｜燕子机场榜" description="搜索燕子机场榜的评测、指南、教程与行业观察。" noindex>
  <PageHeader eyebrow="SEARCH" title="站内搜索" description="输入主题、问题或关键词。搜索在你的浏览器中完成，不记录查询内容。" />
  <section class="container search-area"><div class="search-box"><Search size={22}/><label class="sr-only" for="q">搜索文章</label><input id="q" type="search" placeholder="例如：公共 Wi-Fi、DNS、续费……" autocomplete="off" /></div><p id="status">共收录 {posts.length} 篇文章</p><div id="results"></div></section>
  <script define:vars={{ posts }}>
    const input = document.querySelector('#q'); const results = document.querySelector('#results'); const status = document.querySelector('#status');
    const render = (query='') => { const q=query.trim().toLowerCase(); const list=q ? posts.filter(p => [p.title,p.description,p.category,...p.tags].join(' ').toLowerCase().includes(q)) : posts; const local=location.protocol==='file:'; status.textContent=q ? `找到 ${list.length} 篇相关文章` : `共收录 ${list.length} 篇文章`; results.innerHTML=list.map(p=>{const href=local?`../${p.url.slice(1)}index.html`:p.url;return `<a href="${href}"><span>${p.category}</span><h2>${p.title}</h2><p>${p.description}</p></a>`}).join('') || '<div class="empty">没有找到结果。试试更短的关键词。</div>'; }; const initial=new URLSearchParams(location.search).get('q')||''; input.value=initial; input.addEventListener('input',e=>render(e.target.value)); render(initial);
  </script>
</BaseLayout>
<style>
  .search-area{padding-top:48px;padding-bottom:96px}.search-box{display:flex;align-items:center;gap:12px;padding:0 18px;border:1px solid #36536d;background:#030a14}.search-box svg{color:var(--green)}input{width:100%;padding:18px 0;border:0;outline:0;color:var(--ink);background:transparent;font-family:var(--mono);font-size:.82rem}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}#status{color:#61798f;font-family:var(--mono);font-size:.62rem}#results{border:1px solid var(--line);background:#07111e}#results :global(a){display:grid;grid-template-columns:130px 1fr;gap:8px 25px;padding:25px;border-bottom:1px solid var(--line)}#results :global(a:hover){background:#0b1a2a}#results :global(span){grid-row:1/3;color:var(--accent);font-family:var(--mono);font-size:.62rem;font-weight:600}#results :global(h2){margin:0;font-size:1.2rem}#results :global(p){margin:0;color:var(--muted);font-size:.79rem}#results :global(.empty){padding:50px;color:var(--muted)}@media(max-width:600px){#results :global(a){grid-template-columns:1fr}#results :global(span){grid-row:auto}}
</style>
