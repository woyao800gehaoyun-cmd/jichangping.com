---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { categories } from '../../data/site';
export function getStaticPaths() { return categories.map((category) => ({ params: { slug: category.slug }, props: { category } })); }
const { category } = Astro.props;
const posts = (await getCollection('posts', ({ data }) => !data.draft && data.category === category.name)).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title={`${category.name}｜燕子机场榜`} description={category.description}>
  <PageHeader eyebrow="CATEGORY" title={category.name} description={category.description} count={posts.length} />
  <section class="container posts"><div class="grid-3">{posts.map((post, i) => <ArticleCard post={post} index={i} />)}</div></section>
</BaseLayout>
<style>.posts{padding-top:58px;padding-bottom:96px}.grid-3{row-gap:24px}</style>
