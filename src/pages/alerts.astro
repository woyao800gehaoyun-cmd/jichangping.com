---
import { AlertTriangle, CheckCircle2, Clock3, FileSearch, RadioTower, ShieldAlert } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const updated = '2026-10-05';
const levels = [
  { code: 'L0', title: '正常监测', tone: 'normal', text: '官网、订阅、节点和支持渠道运行，无集中异常证据。' },
  { code: 'L1', title: '观察中', tone: 'watch', text: '单项异常或短时维护，尚不足以判断服务将停止。' },
  { code: 'L2', title: '较高风险', tone: 'risk', text: '多项异常持续出现，且公告、工单或退款处理明显失常。' },
  { code: 'L3', title: '确认失联', tone: 'danger', text: '官网、订阅和支持长期失效，并有多来源、可留档证据。' }
];
const signals = [
  ['异常长期套餐', '突然集中销售明显低于历史价格的多年套餐，并制造付款倒计时。'],
  ['核心服务同时失效', '官网与备用网址、订阅更新、主要节点在多个网络中同时不可用。'],
  ['支持渠道失联', '工单、邮件和公告渠道长期无回应，维护说明反复推迟或被删除。'],
  ['收款身份频繁变化', '短期内多次更换收款方式，并要求向无法核验的新账户重复付款。'],
  ['信息清理异常', '删除历史公告、关闭讨论、隐藏套餐规则或阻止用户核对旧订单。'],
  ['退款与余额异常', '停止退款、余额无法使用、套餐被单方面缩短且没有合理说明。']
];
---
<BaseLayout title="跑路机场预警｜机场失联风险与核验记录" description="提供机场跑路风险信号、预警等级、核验流程和公开记录；不把单次故障或未经证实的传言直接定性为跑路。">
  <PageHeader eyebrow="ROUTE RISK RADAR" title="跑路机场预警" description="预警不是群聊传言汇总。本站只根据可留档、可交叉验证的公开证据提高风险等级，并保留更正入口。" count={0} />

  <section class="container alert-status">
    <div class="status-main"><span><CheckCircle2 size={17}/> CURRENT STATUS</span><h2 class="display">暂无已核验的<br/>确认失联名单</h2><p>这不代表所有服务都没有风险，只表示本站当前没有足够证据公开点名。最后复核：{updated}</p></div>
    <div class="status-board"><div><b>0</b><span>确认失联</span></div><div><b>0</b><span>较高风险</span></div><div><b>持续</b><span>公开信息监测</span></div></div>
  </section>

  <section class="section alert-levels"><div class="container"><div class="section-head"><div><p class="eyebrow">ALERT LEVELS</p><h2 class="display">预警等级怎么划分</h2></div><p>单次节点故障、临时维护或个别客服回复慢，不足以直接判定跑路。</p></div><div class="level-grid">{levels.map((level) => <article class={`tone-${level.tone}`}><span>{level.code}</span><h3>{level.title}</h3><p>{level.text}</p></article>)}</div></div></section>

  <section class="section signal-section"><div class="container signal-grid"><div><p class="eyebrow">RISK SIGNALS</p><h2 class="display">六类组合风险信号</h2><p>风险来自多个异常同时出现并持续，而不是某一个截图或一句传言。购买长期套餐前，可以按此清单复核。</p></div><div class="signal-list">{signals.map(([title, text], index) => <article><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div></div></section>

  <section class="container verification"><div class="section-head"><div><p class="eyebrow">VERIFICATION FLOW</p><h2 class="display">从线索到公开预警</h2></div></div><div class="flow"><div><AlertTriangle/><b>发现异常</b><span>记录时间与现象</span></div><i></i><div><FileSearch/><b>交叉核对</b><span>多个网络和来源</span></div><i></i><div><Clock3/><b>持续观察</b><span>区分维护与失联</span></div><i></i><div><ShieldAlert/><b>发布等级</b><span>标注证据与日期</span></div><i></i><div><RadioTower/><b>复查归档</b><span>恢复或更正记录</span></div></div></section>

  <section class="container evidence-note"><AlertTriangle size={23}/><div><h2>看到“跑路消息”时先做什么</h2><p>暂停续费和大额预付，保存订单、套餐条款和公开公告；从已验证域名查看状态，不向突然出现的“新客服”发送验证码、订阅链接或重复付款。若只是短时故障，等待正式公告比反复重装客户端更安全。</p></div></section>
</BaseLayout>
<style>
  .alert-status{display:grid;grid-template-columns:1.1fr .9fr;gap:1px;margin-top:64px;margin-bottom:76px;border:1px solid var(--line);background:var(--line)}.status-main,.status-board{background:var(--season-surface)}.status-main{padding:42px}.status-main>span{display:inline-flex;align-items:center;gap:8px;color:var(--green);font-family:var(--mono);font-size:.65rem;font-weight:700}.status-main h2{margin:24px 0 15px;font-size:clamp(2.2rem,4vw,4rem)}.status-main p{max-width:650px;margin:0;color:var(--muted);font-size:.84rem}.status-board{display:grid;grid-template-columns:1fr 1fr}.status-board div{display:flex;flex-direction:column;justify-content:center;align-items:center;min-height:160px;border-left:1px solid var(--line);border-bottom:1px solid var(--line)}.status-board div:last-child{grid-column:1/-1;border-bottom:0}.status-board b{color:var(--accent);font-family:var(--mono);font-size:2rem}.status-board span{color:var(--muted);font-size:.72rem}.alert-levels{border-block:1px solid var(--line);background:var(--season-surface-2)}.level-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.level-grid article{min-height:190px;padding:22px;border:1px solid var(--line);background:var(--season-surface)}.level-grid span{font-family:var(--mono);font-size:.65rem;font-weight:700}.level-grid h3{margin:50px 0 10px;font-size:1rem}.level-grid p{margin:0;color:var(--muted);font-size:.76rem}.tone-normal{border-top:5px solid #2f9e65!important}.tone-watch{border-top:5px solid #d3a324!important}.tone-risk{border-top:5px solid #df792f!important}.tone-danger{border-top:5px solid #c94a54!important}.signal-section{background:var(--season-base)}.signal-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:70px}.signal-grid>div:first-child>h2{margin:0;font-size:clamp(2.2rem,4vw,3.8rem)}.signal-grid>div:first-child>p:not(.eyebrow){color:var(--muted);font-size:.86rem}.signal-list{border:1px solid var(--line);background:var(--season-surface)}.signal-list article{display:grid;grid-template-columns:42px 1fr;gap:15px;padding:18px 20px;border-bottom:1px solid var(--line)}.signal-list article:last-child{border:0}.signal-list span{color:var(--accent);font-family:var(--mono);font-size:.65rem;font-weight:700}.signal-list h3{margin:0 0 4px;font-size:.9rem}.signal-list p{margin:0;color:var(--muted);font-size:.74rem}.verification{padding-top:75px;padding-bottom:70px}.flow{display:grid;grid-template-columns:1fr 35px 1fr 35px 1fr 35px 1fr 35px 1fr;align-items:center}.flow>div{display:grid;min-height:145px;padding:18px;place-items:center;text-align:center;border:1px solid var(--line);background:var(--season-surface)}.flow svg{color:var(--green)}.flow b{font-size:.83rem}.flow span{color:var(--muted);font-size:.66rem}.flow>i{border-top:1px dashed var(--green)}.evidence-note{display:flex;gap:20px;margin-bottom:96px;padding:26px;border:1px solid var(--line-bright);border-left:5px solid var(--accent);background:var(--season-surface-2)}.evidence-note svg{flex:0 0 auto;color:var(--accent)}.evidence-note h2{margin:0 0 7px;font-size:1rem}.evidence-note p{margin:0;color:var(--muted);font-size:.82rem}
  @media(max-width:850px){.alert-status,.signal-grid{grid-template-columns:1fr}.level-grid{grid-template-columns:1fr 1fr}.flow{grid-template-columns:1fr}.flow>i{height:22px;border-top:0;border-left:1px dashed var(--green);justify-self:center}}@media(max-width:520px){.level-grid{grid-template-columns:1fr}.status-board{grid-template-columns:1fr}.status-board div,.status-board div:last-child{grid-column:auto;border-left:0}}
</style>
