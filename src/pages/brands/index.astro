---
import { getCollection } from 'astro:content';
import { ArrowUpRight, ClipboardCheck, ExternalLink, Scale, ShieldCheck } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
const brands = await getCollection('brands', ({ data }) => !data.draft);
const dimensions = [
  { icon: ShieldCheck, title: '隐私与安全', text: '政策、默认设置、协议、审计范围与历史响应。' },
  { icon: ClipboardCheck, title: '实际体验', text: '跨设备安装、连接稳定、恢复能力与任务表现。' },
  { icon: Scale, title: '价格与边界', text: '首期、续费、退款、限制和退出成本一起核对。' }
];
---
<BaseLayout title="机场榜单｜燕子机场榜" description="以统一框架整理机场与网络工具品牌资料、实测结论、适用人群和主要限制。">
  <PageHeader eyebrow="AIRPORT RANK" title="机场榜单" description="不做 Logo 墙，也不按佣金排序。每份档案使用同一套核对框架，并标明资料复查时间。" count={brands.length} />
  <section class="container principles"><div class="grid-3">{dimensions.map(({icon:Icon,title,text}) => <article><Icon size={23}/><h2>{title}</h2><p>{text}</p></article>)}</div></section>
  <section class="container brand-list">
    {brands.length ? brands.map((brand) => <article class="brand-row"><span>{brand.data.status}</span><div><h2 class="display"><a href={`/brands/${brand.id}/`}>{brand.data.name}</a></h2>{brand.data.affiliate && <small>含推广链接</small>}</div><p>{brand.data.description}</p><div class="actions"><a class="detail" href={`/brands/${brand.id}/`} aria-label={`查看${brand.data.name}档案`}><ArrowUpRight size={19}/></a>{brand.data.externalUrl && <a class="external" href={brand.data.externalUrl} target="_blank" rel={brand.data.affiliate ? 'sponsored nofollow noopener noreferrer' : 'noopener noreferrer'}>访问注册页 <ExternalLink size={14}/></a>}</div></article>) : <div class="empty"><p class="eyebrow">COMING AFTER VERIFICATION</p><h2 class="display">具体品牌档案将在完成事实核验后发布。</h2><p>内容模型和页面模板已经就绪。我们不会用虚构评分或未经核对的价格填充页面。</p></div>}
  </section>
</BaseLayout>
<style>
  .principles{padding-top:52px}.principles article{padding:25px;border:1px solid var(--line);background:#081321}.principles svg{color:var(--green)}.principles h2{margin:28px 0 8px;font-size:1rem}.principles p{color:var(--muted);font-size:.79rem}.brand-list{padding-top:40px;padding-bottom:96px}.brand-row{display:grid;grid-template-columns:105px minmax(150px,.75fr) 1.2fr auto;align-items:center;gap:24px;padding:24px;border:1px solid var(--line);border-bottom:0;background:#07111e}.brand-row:last-child{border-bottom:1px solid var(--line)}.brand-row:hover{background:#0b1a2a}.brand-row>span{color:var(--accent);font-family:var(--mono);font-size:.62rem}.brand-row h2,.brand-row p{margin:0}.brand-row h2{font-size:1.3rem}.brand-row h2 a:hover{color:var(--green)}.brand-row small{display:inline-block;margin-top:7px;padding:3px 7px;border:1px solid #694f28;color:#d4a752;font-family:var(--mono);font-size:.56rem}.brand-row p{color:var(--muted);font-size:.8rem}.actions{display:flex;align-items:center;gap:9px}.detail{display:grid;width:36px;height:36px;place-items:center;border:1px solid var(--line)}.external{display:inline-flex;align-items:center;gap:6px;min-height:36px;padding:0 12px;border:1px solid var(--green);color:#07111e;background:var(--green);font-size:.68rem;font-weight:700}.external:hover{filter:brightness(1.08)}.empty{position:relative;overflow:hidden;padding:60px;border:1px solid var(--line);background:#081321}.empty::after{content:'NO FLIGHTS SCHEDULED';position:absolute;right:-25px;bottom:20px;color:#1a3044;font-family:var(--mono);font-size:2rem;font-weight:700;transform:rotate(-5deg)}.empty h2{position:relative;z-index:2;max-width:700px;margin:0;font-size:2.5rem}.empty>p:last-child{position:relative;z-index:2;max-width:650px;color:var(--muted)}@media(max-width:850px){.brand-row{grid-template-columns:90px 1fr}.brand-row>p,.brand-row>.actions{grid-column:2}.actions{justify-content:flex-start}}@media(max-width:550px){.brand-row{grid-template-columns:1fr}.brand-row>p,.brand-row>.actions{grid-column:auto}.empty{padding:30px}.empty h2{font-size:2rem}}
</style>
