---
import { getCollection, render } from 'astro:content';
import { Check, Minus, MonitorSmartphone } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths(){const brands=await getCollection('brands',({data})=>!data.draft);return brands.map((brand)=>({params:{slug:brand.id},props:{brand}}));}
const { brand } = Astro.props;
const { Content } = await render(brand);
---
<BaseLayout title={`${brand.data.name}品牌档案｜燕子机场榜`} description={brand.data.description} type="article" publishedAt={brand.data.reviewedAt}>
  <header class="brand-head"><div class="container"><p class="eyebrow">品牌档案 · {brand.data.status}</p><h1 class="display">{brand.data.name}</h1><p class="tagline">{brand.data.tagline}</p><p>{brand.data.description}</p><small>资料复查：{brand.data.reviewedAt.toLocaleDateString('zh-CN')}</small></div></header>
  <div class="container brand-grid"><aside><p>快速资料</p>{brand.data.founded&&<span>成立：{brand.data.founded}</span>}{brand.data.jurisdiction&&<span>注册地：{brand.data.jurisdiction}</span>}<span><MonitorSmartphone size={15}/> {brand.data.platforms.join('、')}</span></aside><article class="prose"><section class="pros-cons"><div><h2>值得关注</h2>{brand.data.strengths.map((v)=><p><Check size={16}/>{v}</p>)}</div><div><h2>主要限制</h2>{brand.data.limitations.map((v)=><p><Minus size={16}/>{v}</p>)}</div></section><Content /></article></div>
</BaseLayout>
<style>
  .brand-head{padding:75px 0 55px;color:white;background:var(--green)}.brand-head h1{margin:0;font-size:clamp(3.5rem,8vw,7rem)}.brand-head .tagline{font-family:var(--serif);font-size:1.5rem}.brand-head p:not(.eyebrow){max-width:700px}.brand-head small{color:#b7cec2}.brand-grid{display:grid;grid-template-columns:190px minmax(0,720px);justify-content:center;gap:60px;padding-top:60px;padding-bottom:90px}.brand-grid aside{font-size:.78rem}.brand-grid aside>p{font-weight:700}.brand-grid aside span{display:flex;gap:7px;margin:10px 0;color:var(--muted)}.pros-cons{display:grid;grid-template-columns:1fr 1fr;gap:1px;margin-bottom:50px;background:var(--line)}.pros-cons>div{padding:20px;background:var(--white)}.pros-cons h2{margin-top:0;font-size:1.2rem}.pros-cons p{display:flex;gap:8px;font-size:.82rem}.prose :global(h2){margin-top:2em;font-family:var(--serif);font-size:2rem}.prose :global(p){line-height:1.9}@media(max-width:700px){.brand-grid{display:block}.brand-grid aside{margin-bottom:35px}.pros-cons{grid-template-columns:1fr}}
</style>
