---
import { getCollection, render } from 'astro:content';
import { ArrowLeft, CalendarDays, Clock3, Plane, RefreshCw } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { categoryByName } from '../../data/site';
export async function getStaticPaths(){const posts=await getCollection('posts',({data})=>!data.draft);return posts.map((post)=>({params:{slug:post.id},props:{post}}));}
const { post }=Astro.props;const { Content,headings }=await render(post);const allPosts=await getCollection('posts',({data})=>!data.draft);const related=allPosts.filter((p)=>p.id!==post.id&&(p.data.category===post.data.category||p.data.tags.some((t)=>post.data.tags.includes(t)))).slice(0,3);const category=categoryByName[post.data.category];const published=post.data.publishedAt.toLocaleDateString('zh-CN',{year:'numeric',month:'long',day:'numeric'});const updated=post.data.updatedAt?.toLocaleDateString('zh-CN',{year:'numeric',month:'long',day:'numeric'});
---
<BaseLayout title={`${post.data.title}｜燕子机场榜`} description={post.data.description} type="article" publishedAt={post.data.publishedAt} updatedAt={post.data.updatedAt}>
  <article><header class="article-hero"><div class="container hero-grid"><div><a class="back" href={`/category/${category.slug}/`}><ArrowLeft size={15}/> RETURN TO {post.data.category}</a><p class="eyebrow">FLIGHT REPORT / {post.data.category}</p><h1 class="display">{post.data.title}</h1><p class="deck">{post.data.description}</p><div class="article-meta"><span><CalendarDays size={14}/> DEP {published}</span>{updated&&<span><RefreshCw size={14}/> REV {updated}</span>}<span><Clock3 size={14}/> ETA {post.data.readingTime} MIN</span></div></div><aside class="boarding-pass"><div><span>BOARDING PASS</span><b>SR-ARTICLE</b></div><section><small>FROM</small><strong>CN</strong><Plane size={23}/><small>TO</small><strong>NET</strong></section><footer><span>GATE<br/><b>A03</b></span><span>CLASS<br/><b>GUIDE</b></span><span>STATUS<br/><b>ON TIME</b></span></footer></aside></div></header>
  <div class="container content-grid"><aside class="toc"><p>ROUTE STOPS / 目录</p><ol>{headings.filter((h)=>h.depth===2).map((h,i)=><li><span>{String(i+1).padStart(2,'0')}</span><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol><div class="disclosure">独立编辑内容，不含具体购买链接。<a href="/disclosure/">查看推广披露</a></div></aside><div class="prose"><div class="author"><span>SR</span><div><strong>{post.data.author}</strong><small>CONTROL TOWER EDITORIAL TEAM</small></div></div><Content/><div class="article-note"><strong>航路提示 / NOTICE</strong><p>网络环境与产品能力会随时间变化。请以服务方当前条款和所在地法律为准，不要将本文视为法律或安全承诺。</p></div></div><aside class="side"><p>ROUTE TAGS</p><div>{post.data.tags.map((tag)=><span class="tag">{tag}</span>)}</div><hr/><a href="/editorial-policy/">OPEN REVIEW RADAR →</a></aside></div></article>
  {related.length>0&&<section class="related"><div class="container"><div class="section-head"><div><p class="eyebrow">CONNECTING FLIGHTS</p><h2 class="display">继续中转阅读</h2></div></div><div class="grid-3">{related.map((item,i)=><ArticleCard post={item} index={i}/>)}</div></div></section>}<Newsletter/>
</BaseLayout>
<style>
  .article-hero{position:relative;overflow:hidden;padding:62px 0;background:#07101e;border-bottom:1px solid #29445e}.article-hero::before{content:'';position:absolute;inset:0;background-image:linear-gradient(#18324a55 1px,transparent 1px),linear-gradient(90deg,#18324a55 1px,transparent 1px);background-size:38px 38px;mask-image:linear-gradient(90deg,#000,transparent)}.hero-grid{position:relative;display:grid;grid-template-columns:1fr 300px;gap:60px;align-items:center}.back{display:inline-flex;align-items:center;gap:7px;margin-bottom:35px;color:#718ba1;font-family:var(--mono);font-size:.6rem}h1{max-width:930px;margin:0;font-size:clamp(2.35rem,4.8vw,4.35rem)}.deck{max-width:780px;margin:22px 0;color:#9cb0c2;font-size:.94rem}.article-meta{display:flex;flex-wrap:wrap;gap:22px;color:#7890a5;font-family:var(--mono);font-size:.6rem}.article-meta span{display:flex;align-items:center;gap:6px}.boarding-pass{border:1px solid #4a6172;color:#09111b;background:#dce5e8;transform:rotate(2deg);box-shadow:15px 15px 0 #02071166}.boarding-pass>div{display:flex;justify-content:space-between;padding:12px 15px;border-bottom:1px dashed #78878d;font-family:var(--mono);font-size:.57rem}.boarding-pass>div b{color:#9a5a00}.boarding-pass section{display:grid;grid-template-columns:auto 1fr auto auto 1fr;align-items:end;gap:7px;padding:24px 15px}.boarding-pass section small{font-family:var(--mono);font-size:.5rem}.boarding-pass section strong{font-family:var(--mono);font-size:1.7rem}.boarding-pass section svg{color:#9a5a00;transform:rotate(40deg)}.boarding-pass footer{display:grid;grid-template-columns:repeat(3,1fr);padding:12px 15px;border-top:1px dashed #78878d;font-family:var(--mono);font-size:.5rem}.boarding-pass footer b{font-size:.65rem}
  .content-grid{display:grid;grid-template-columns:210px minmax(0,720px) 190px;justify-content:space-between;gap:45px;padding-top:68px;padding-bottom:96px}.toc,.side{position:sticky;top:125px;align-self:start;color:var(--muted);font-size:.72rem}.toc>p,.side>p{margin-top:0;color:var(--green);font-family:var(--mono);font-size:.6rem;letter-spacing:.08em}.toc ol{margin:0;padding:0;list-style:none}.toc li{display:grid;grid-template-columns:24px 1fr;gap:8px;margin:13px 0}.toc li span{color:#4e667d;font-family:var(--mono);font-size:.57rem}.toc a:hover,.side a:hover{color:var(--accent)}.disclosure{margin-top:27px;padding-top:18px;border-top:1px solid var(--line);font-size:.68rem}.disclosure a{display:block;margin-top:7px;color:var(--accent)}.side div{display:flex;flex-wrap:wrap;gap:6px}.side hr{border:0;border-top:1px solid var(--line);margin:22px 0}.side>a{color:#6f899e;font-family:var(--mono);font-size:.57rem}.author{display:flex;align-items:center;gap:12px;margin-bottom:40px;padding-bottom:20px;border-bottom:1px solid var(--line)}.author>span{display:grid;width:43px;height:43px;place-items:center;border:1px solid #41617a;color:var(--accent);background:#0b1828;font-family:var(--mono);font-weight:700}.author strong,.author small{display:block}.author small{color:#617a90;font-family:var(--mono);font-size:.53rem}.prose :global(h2){margin:2.35em 0 .75em;padding-left:17px;border-left:3px solid var(--accent);font-size:1.75rem;line-height:1.35;scroll-margin-top:120px}.prose :global(h3){margin-top:2em;color:#d4e5f3}.prose :global(p),.prose :global(li){color:#b7c6d3;font-size:.96rem;line-height:1.95}.prose :global(p){margin:0 0 1.45em}.prose :global(a){color:var(--green);text-decoration:underline;text-underline-offset:3px}.article-note{margin-top:50px;padding:24px;border:1px solid #3b4e5e;border-left:3px solid var(--accent);background:#0c1726}.article-note strong{color:var(--accent);font-family:var(--mono);font-size:.7rem}.article-note p{margin:7px 0 0;color:var(--muted);font-size:.8rem}.related{padding:82px 0;background:#081220;border-top:1px solid #263f56}
  @media(max-width:1040px){.hero-grid{grid-template-columns:1fr}.boarding-pass{display:none}.content-grid{grid-template-columns:minmax(0,720px) 180px;justify-content:center}.toc{display:none}}
  @media(max-width:720px){.article-hero{padding:45px 0}.content-grid{display:block;padding-top:38px}.side{position:static;margin-top:40px;padding-top:22px;border-top:1px solid var(--line)}.prose :global(h2){font-size:1.55rem}}
</style>
