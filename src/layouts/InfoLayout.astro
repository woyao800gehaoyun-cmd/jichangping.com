---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
interface Props { title: string; description: string; eyebrow?: string; updated?: string; }
const { title, description, eyebrow = 'STATION INFORMATION', updated = '2026 年 10 月' } = Astro.props;
---
<BaseLayout title={`${title}｜燕子机场榜`} description={description}><PageHeader title={title} description={description} eyebrow={eyebrow}/><div class="container info-grid"><aside><p>TERMINAL MENU</p><a href="/recommendations/">机场推荐</a><a href="/faq/">问题库</a><a href="/alerts/">跑路预警</a><a href="/about/">关于本站</a><a href="/editorial-policy/">编辑规范</a><a href="/disclosure/">推广披露</a><a href="/privacy/">隐私说明</a><small>LAST UPDATE<br/>{updated}</small></aside><article class="prose"><slot /></article></div></BaseLayout>
<style>
  .info-grid{display:grid;grid-template-columns:210px minmax(0,780px);justify-content:center;gap:70px;padding-top:64px;padding-bottom:96px}.info-grid aside{position:sticky;top:120px;align-self:start;padding:18px;border:1px solid var(--line);background:var(--season-surface)}.info-grid aside p{margin:0 0 10px;color:var(--green);font-family:var(--mono);font-size:.6rem;font-weight:700;letter-spacing:.1em}.info-grid aside a{display:block;padding:10px 0;border-bottom:1px solid var(--line);color:var(--muted);font-size:.78rem}.info-grid aside a:hover{color:var(--accent)}.info-grid aside small{display:block;margin-top:28px;color:var(--muted);font-family:var(--mono);font-size:.55rem;line-height:1.8}.prose :global(h2){margin:2em 0 .6em;padding-left:16px;border-left:3px solid var(--accent);color:var(--season-text);font-size:1.65rem}.prose :global(h2:first-child){margin-top:0}.prose :global(h3){margin-top:2em;color:var(--season-text)}.prose :global(p),.prose :global(li){color:color-mix(in srgb,var(--season-text) 86%,var(--season-muted));font-size:.97rem;line-height:1.95}.prose :global(li){margin-bottom:.5em}.prose :global(a){color:var(--green);font-weight:600;text-decoration:underline}.prose :global(blockquote){margin:2em 0;padding:18px 24px;border:1px solid var(--line-bright);border-left:3px solid var(--accent);background:var(--season-surface-2)}.prose :global(code){color:var(--accent-dark)}
  @media(max-width:700px){.info-grid{display:block}.info-grid aside{position:static;display:flex;gap:15px;overflow:auto;margin-bottom:40px}.info-grid aside p,.info-grid aside small{display:none}.info-grid aside a{flex:0 0 auto;border:0}}
</style>
