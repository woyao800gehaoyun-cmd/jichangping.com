---
import { Plane, RadioTower } from 'lucide-astro';
interface Props { eyebrow?: string; title: string; description: string; count?: number; }
const { eyebrow = 'TRANSIT TERMINAL', title, description, count } = Astro.props;
---
<header class="page-head">
  <div class="container grid"><div class="copy"><p class="eyebrow">{eyebrow}</p><div class="title-row"><h1 class="display">{title}</h1>{count !== undefined && <span>{String(count).padStart(2, '0')} ROUTES</span>}</div><p class="desc">{description}</p></div><div class="radar" aria-hidden="true"><i></i><i></i><i></i><Plane size={24}/><RadioTower size={18}/></div></div>
  <div class="ticker"><div>ARRIVALS</div><div>DEPARTURES</div><div>ROUTE STATUS: NORMAL</div><div>UTC+08 / CN HUB</div></div>
</header>
<style>
  .page-head { position: relative; overflow: hidden; padding: 64px 0 0; color: var(--ink); background: #07101e; border-bottom: 1px solid #29445e; }.page-head::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(#19314a55 1px,transparent 1px),linear-gradient(90deg,#19314a55 1px,transparent 1px); background-size: 32px 32px; mask-image: linear-gradient(90deg,#000,transparent 80%); }.grid { position: relative; display: grid; grid-template-columns: 1fr 330px; gap: 40px; align-items: center; padding-bottom: 52px; }.copy { position: relative; z-index: 2; }.title-row { display: flex; align-items: start; justify-content: space-between; gap: 20px; } h1 { max-width: 880px; margin: 0; font-size: clamp(2.5rem, 5vw, 4.7rem); }.title-row span { margin-top: 12px; padding: 5px 8px; border: 1px solid #38617c; color: var(--green); font-family: var(--mono); font-size: .6rem; white-space: nowrap; }.desc { max-width: 720px; margin: 19px 0 0; color: #9eb1c3; font-size: .9rem; }
  .radar { position: relative; width: 240px; aspect-ratio: 1; margin-left: auto; border: 1px solid #294f69; border-radius: 50%; background: repeating-radial-gradient(circle,transparent 0 38px,#25435a 39px 40px); }.radar::before,.radar::after { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; border-left: 1px solid #294f69; }.radar::after { transform: rotate(90deg); }.radar i { position: absolute; left: 50%; top: 50%; width: 48%; border-top: 1px dashed #4de1ff99; transform-origin: left; }.radar i:nth-child(1){transform:rotate(-25deg)}.radar i:nth-child(2){transform:rotate(38deg)}.radar i:nth-child(3){transform:rotate(145deg)}.radar > svg:nth-of-type(1){position:absolute;left:72%;top:27%;color:var(--accent);transform:rotate(38deg)}.radar > svg:nth-of-type(2){position:absolute;left:calc(50% - 9px);top:calc(50% - 9px);color:var(--green)}
  .ticker { position: relative; display: grid; grid-template-columns: repeat(4,1fr); border-top: 1px solid #233c54; color: #8198ac; background: #050b15; font-family: var(--mono); font-size: .58rem; letter-spacing: .08em; }.ticker div { padding: 11px 20px; border-right: 1px solid #233c54; }.ticker div:nth-child(3) { color: #79efa5; }
  @media (max-width: 720px) { .page-head { padding-top: 44px; }.grid { grid-template-columns: 1fr; padding-bottom: 36px; }.radar { display: none; } h1 { font-size: 2.65rem; }.ticker { grid-template-columns: 1fr 1fr; }.ticker div:nth-child(n+3){display:none} }
</style>
