---
import type { CollectionEntry } from 'astro:content';
import { ArrowUpRight, Clock3, Plane } from 'lucide-astro';
interface Props { post: CollectionEntry<'posts'>; index?: number; featured?: boolean; }
const { post, index = 0, featured = false } = Astro.props;
const date = post.data.publishedAt.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
const flight = `SR${String(index + 17).padStart(3, '0')}`;
const gate = ['A03', 'B12', 'C07', 'D21'][index % 4];
---
<article class:list={['ticket', `tone-${post.data.coverTone}`, { featured }]}> 
  <a class="route" href={`/articles/${post.id}/`} aria-label={post.data.title}><div class="route-head"><span>{flight}</span><span>STATUS <i></i> ON TIME</span></div><div class="route-map"><b>CN</b><span><Plane size={18} /></span><b>NET</b></div><div class="route-foot"><span>GATE {gate}</span><span>SWALLOW TRANSIT</span></div></a>
  <div class="body"><div class="meta"><span>{post.data.category}</span><time datetime={post.data.publishedAt.toISOString()}>{date}</time></div><h3><a href={`/articles/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><div class="foot"><span><Clock3 size={13} /> ETA {post.data.readingTime} MIN</span><a class="arrow" href={`/articles/${post.id}/`} aria-label={`阅读：${post.data.title}`}>登机阅读 <ArrowUpRight size={15} /></a></div></div>
</article>
<style>
  .ticket { position: relative; min-width: 0; overflow: hidden; border: 1px solid var(--line); background: #091424; transition: transform .22s, border-color .22s, box-shadow .22s; }.ticket::before,.ticket::after { content: ''; position: absolute; z-index: 3; top: 117px; width: 18px; height: 18px; border: 1px solid var(--line); border-radius: 50%; background: var(--paper); }.ticket::before { left: -10px; }.ticket::after { right: -10px; }.ticket:hover { transform: translateY(-4px); border-color: #3b617f; box-shadow: 0 20px 45px #0008, 0 0 30px #4de1ff0c; }
  .route { position: relative; display: block; height: 126px; overflow: hidden; padding: 15px 18px; border-bottom: 1px dashed #35506c; color: #d9edff; background-color: #0d1c30; background-image: radial-gradient(circle at 30% 20%, #214260 0 1px, transparent 2px), radial-gradient(circle at 70% 70%, #214260 0 1px, transparent 2px); background-size: 38px 38px, 52px 52px; }.route::after { content: ''; position: absolute; inset: 0; background: linear-gradient(110deg, transparent 50%, #4de1ff0a 50%); }.route-head,.route-foot { position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: center; font-family: var(--mono); font-size: .57rem; letter-spacing: .1em; }.route-head > span:first-child { color: var(--accent); font-size: .7rem; font-weight: 700; }.route-head i { display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: #7bf3a8; box-shadow: 0 0 8px #7bf3a8; }
  .route-map { position: relative; z-index: 2; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px; margin: 19px 0 13px; font-family: var(--mono); font-size: 1.18rem; }.route-map > span { position: relative; display: flex; align-items: center; justify-content: center; color: var(--green); }.route-map > span::before { content: ''; position: absolute; left: 0; right: 0; border-top: 1px dashed #4de1ff88; }.route-map svg { position: relative; z-index: 2; padding: 2px; background: #0d1c30; transform: rotate(40deg); }.route-foot { color: #6f89a3; }
  .body { padding: 20px; }.meta,.foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: var(--muted); font-family: var(--mono); font-size: .63rem; }.meta span { color: var(--green); font-weight: 600; letter-spacing: .08em; } h3 { margin: 13px 0 9px; font-size: 1.06rem; font-weight: 700; line-height: 1.5; } h3 a:hover { color: var(--green); } p { margin: 0 0 18px; color: var(--muted); font-size: .79rem; line-height: 1.75; }.foot { padding-top: 14px; border-top: 1px solid #1b3046; }.foot span,.arrow { display: inline-flex; align-items: center; gap: 6px; }.arrow { color: var(--accent); font-weight: 600; }
  .featured { display: grid; grid-template-columns: .85fr 1.15fr; }.featured::before,.featured::after { top: 50%; transform: translateY(-50%); }.featured .route { height: 100%; min-height: 310px; border-right: 1px dashed #35506c; border-bottom: 0; display: flex; flex-direction: column; justify-content: space-between; padding: 27px; }.featured .route-map { margin: auto 0; font-size: 1.65rem; }.featured .route-map svg { width: 28px; height: 28px; }.featured .body { display: flex; flex-direction: column; justify-content: center; padding: 38px; }.featured h3 { font-size: clamp(1.55rem, 2.7vw, 2.25rem); }
  @media (max-width: 650px) { .featured { display: block; }.featured .route { min-height: 180px; border-right: 0; border-bottom: 1px dashed #35506c; }.featured::before,.featured::after { top: 171px; transform: none; }.featured .body { padding: 22px; } }
</style>
