---
import { Menu, Plane, Radar, Search, X } from 'lucide-astro';
const pathname = Astro.url.pathname;
const nav = [
  { label: '航站榜单', code: 'RANK', href: '/brands/' },
  { label: '深度评测', code: 'REV', href: '/category/reviews/' },
  { label: '航线对比', code: 'CMP', href: '/category/comparisons/' },
  { label: '登机指南', code: 'GUIDE', href: '/category/tutorials/' },
  { label: '全部航报', code: 'ALL', href: '/articles/' }
];
---
<header class="site-header">
  <div class="top-strip"><div class="container"><span>TRANSIT NETWORK / CN</span><span class="live"><i></i> SYSTEM ONLINE</span><span>UTC+08 · {new Date().toISOString().slice(0, 10)}</span></div></div>
  <div class="container bar">
    <a class="brand" href="/" aria-label="燕子机场榜首页"><span class="brand-mark"><Plane size={20} /></span><span><b>燕子航站</b><small>SWALLOW TRANSIT INDEX</small></span></a>
    <nav aria-label="主导航">{nav.map((item) => <a class:list={{ active: pathname.startsWith(item.href) }} href={item.href}><small>{item.code}</small>{item.label}</a>)}</nav>
    <div class="actions"><div class="season-switcher" aria-label="选择季节主题"><button type="button" data-theme-option="spring" title="春季主题" aria-label="切换到春季主题">春</button><button type="button" data-theme-option="summer" title="夏季主题" aria-label="切换到夏季主题">夏</button><button type="button" data-theme-option="autumn" title="秋季主题" aria-label="切换到秋季主题">秋</button><button type="button" data-theme-option="winter" title="冬季主题" aria-label="切换到冬季主题">冬</button></div><a class="icon-button" href="/search/" aria-label="搜索"><Search size={18} /></a><a class="method-link" href="/editorial-policy/"><Radar size={15} /> 评测雷达</a><button class="icon-button menu-toggle" aria-label="打开菜单" aria-expanded="false" aria-controls="mobile-menu"><Menu class="menu-icon" size={21} /><X class="close-icon" size={21} /></button></div>
  </div>
  <nav id="mobile-menu" class="mobile-menu" aria-label="移动导航">{nav.map((item) => <a href={item.href}><span>{item.code}</span>{item.label}</a>)}</nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('.mobile-menu');
  toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') === 'true'; toggle.setAttribute('aria-expanded', String(!open)); menu?.classList.toggle('open', !open); });
  const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-theme-option]');
  const syncThemeButtons = () => themeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.themeOption === document.documentElement.dataset.theme)));
  themeButtons.forEach((button) => button.addEventListener('click', () => {
    const theme = button.dataset.themeOption;
    if (!theme) return;
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem('swallow-season', theme); } catch {}
    syncThemeButtons();
  }));
  syncThemeButtons();
</script>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--line); background: #050b16ed; backdrop-filter: blur(16px); }
  .top-strip { border-bottom: 1px solid #182a40; color: #71879d; background: #030812; font-family: var(--mono); font-size: .57rem; letter-spacing: .12em; }.top-strip .container { display: flex; justify-content: space-between; align-items: center; height: 25px; }.live { color: #86f4b0; }.live i { display: inline-block; width: 5px; height: 5px; margin-right: 6px; border-radius: 50%; background: currentColor; box-shadow: 0 0 8px currentColor; animation: blink 1.5s infinite; }
  .bar { height: 72px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }.brand { display: inline-flex; width: max-content; align-items: center; gap: 11px; line-height: 1; }.brand-mark { display: grid; width: 40px; height: 40px; place-items: center; color: #06101c; background: var(--accent); clip-path: polygon(0 0, 78% 0, 100% 22%, 100% 100%, 22% 100%, 0 78%); }.brand b { display: block; font-size: 1.04rem; letter-spacing: .08em; }.brand small { display: block; margin-top: 6px; color: #748aa0; font-family: var(--mono); font-size: .48rem; letter-spacing: .12em; }
  nav { display: flex; gap: 4px; } nav a { position: relative; min-width: 76px; padding: 10px 11px; color: #b4c5d6; text-align: center; font-size: .76rem; font-weight: 600; transition: .2s; } nav a small { display: block; margin-bottom: 3px; color: #526b82; font-family: var(--mono); font-size: .48rem; letter-spacing: .1em; } nav a:hover, nav a.active { color: var(--ink); background: #0e1d30; } nav a.active::after { content: ''; position: absolute; left: 11px; right: 11px; bottom: 3px; height: 2px; background: var(--green); box-shadow: 0 0 10px var(--green); }
  .actions { display: flex; justify-content: flex-end; align-items: center; gap: 8px; }.season-switcher{display:flex;padding:3px;border:1px solid var(--line);background:color-mix(in srgb,var(--season-base) 80%,black)}.season-switcher button{display:grid;width:27px;height:30px;padding:0;place-items:center;border:0;color:var(--muted);background:transparent;font-size:.68rem;cursor:pointer;transition:.18s}.season-switcher button:hover{color:var(--ink)}.season-switcher button[aria-pressed='true']{color:#071018;background:var(--accent);box-shadow:0 0 14px var(--season-glow);font-weight:800}.icon-button { display: grid; width: 40px; height: 40px; padding: 0; place-items: center; border: 1px solid var(--line); color: #b9cad9; background: #091424; cursor: pointer; }.method-link { display: inline-flex; align-items: center; gap: 7px; padding: 10px 13px; border: 1px solid var(--line-bright); color: var(--accent); background: var(--season-surface); font-family: var(--mono); font-size: .65rem; font-weight: 600; }.menu-toggle, .close-icon { display: none; }.mobile-menu { display: none; }
  @media (max-width: 900px) { .top-strip span:first-child { display: none; }.bar { height: 64px; grid-template-columns: 1fr auto; }.bar > nav { display: none; }.menu-toggle { display: grid; }.menu-toggle[aria-expanded='true'] .menu-icon { display: none; }.menu-toggle[aria-expanded='true'] .close-icon { display: block; }.mobile-menu.open { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; padding: 1px 14px 14px; background: var(--line); }.mobile-menu a { min-width: 0; padding: 14px; text-align: left; background: var(--season-surface); }.mobile-menu a span { display: block; color: var(--green); font-family: var(--mono); font-size: .55rem; }.method-link { display: none; } }
  @media(max-width:560px){.season-switcher{position:absolute;left:14px;right:14px;top:89px;justify-content:center;background:color-mix(in srgb,var(--season-base) 94%,transparent);box-shadow:0 8px 20px #0005}.season-switcher button{width:25%}.site-header{margin-bottom:38px}.icon-button{width:36px}.brand small{display:none}}
</style>
